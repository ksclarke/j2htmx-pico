<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>j2htmx-pico-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>j2htmx-pico-parent</name>
    <description>Java to HTML builder with a fluent API</description>
    <url>https://projects.freelibrary.info/j2htmx-pico</url>

    <licenses>
        <license>
            <name>The Mozilla Public License, Version 2.0</name>
            <url>https://www.mozilla.org/en-US/MPL/2.0/</url>
        </license>
        <license>
            <name>The Apache Software License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git@github.com:freelibrary/j2htmx-pico.git</connection>
        <developerConnection>scm:git:git@github.com:freelibrary/j2htmx-pico.git</developerConnection>
        <url>https://github.com/freelibrary/j2htmx-pico.git</url>
    </scm>

    <developers>
        <developer>
            <id>ksclarke</id>
            <name>Kevin S. Clarke</name>
            <email>my.j2htmx-pico@kevinclarke.info</email>
            <organization>Bruised Edge Software</organization>
            <timezone>America/New_York</timezone>
            <properties>
                <altEmail>freelibrary@bruisededge.com</altEmail>
            </properties>
        </developer>
    </developers>

    <issueManagement>
        <system>GitHub Issue Tracker</system>
        <url>https://github.com/freelibrary/j2htmx-pico/issues</url>
    </issueManagement>

    <modules>
        <module>j2htmx-pico-codegen</module>
        <module>j2htmx-pico</module>
        <module>j2htmx-pico-mathml</module>
    </modules>

    <properties>
        <!-- Application dependencies -->
        <commons-lang3.version>3.20.0</commons-lang3.version>
        <jsoup.version>1.23.2</jsoup.version>
        <javapoet.version>0.19.0</javapoet.version>
        <slf4j.simple.version>2.0.17</slf4j.simple.version>
        <freelib.utils.version>6.0.2</freelib.utils.version>

        <!-- This should be kept in sync with the `project.parent.version` below -->
        <freelib.resources.version>14.3.6</freelib.resources.version>

        <!-- Testing dependencies -->
        <junit.jupiter.version>5.10.2</junit.jupiter.version>
        <mockito.version>5.23.0</mockito.version>
        <hamcrest-library.version>3.0</hamcrest-library.version>

        <!-- Plugin versions -->
        <maven.bundle.version>5.1.6</maven.bundle.version>
        <maven.plugin.version>3.15.2</maven.plugin.version>
        <maven.api.version>3.9.16</maven.api.version>
        <maven.project.version>2.2.1</maven.project.version>
        <maven.annotation.version>3.6.0</maven.annotation.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Application dependencies -->
            <dependency>
                <groupId>org.jsoup</groupId>
                <artifactId>jsoup</artifactId>
                <version>${jsoup.version}</version>
            </dependency>
            <dependency>
                <groupId>com.palantir.javapoet</groupId>
                <artifactId>javapoet</artifactId>
                <version>${javapoet.version}</version>
            </dependency>
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-simple</artifactId>
                <version>${slf4j.simple.version}</version>
            </dependency>
            <dependency>
                <groupId>info.freelibrary</groupId>
                <artifactId>freelib-utils</artifactId>
                <version>${freelib.utils.version}</version>
            </dependency>

            <!-- Test dependencies -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.hamcrest</groupId>
                <artifactId>hamcrest-library</artifactId>
                <version>${hamcrest-library.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.felix</groupId>
                    <artifactId>maven-bundle-plugin</artifactId>
                    <version>${maven.bundle.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <configuration>
                        <rules>
                            <requireReleaseDeps>
                                <excludes>
                                    <exclude>info.freelibrary:j2htmx-pico</exclude>
                                </excludes>
                            </requireReleaseDeps>
                        </rules>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <configuration>
                        <doclint>all,-missing</doclint>
                        <sourcepath>
                            ${project.basedir}/src/main/java:${project.build.directory}/generated-sources/j2html-codegen
                        </sourcepath>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-pmd-plugin</artifactId>
                    <configuration>
                        <analysisCacheLocation>${project.build.directory}/pmd/pmd.cache</analysisCacheLocation>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <inherited>false</inherited>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <executions>
                    <execution>
                        <id>checkstyle</id>
                        <inherited>false</inherited>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>unpack-build-resources</id>
                        <inherited>false</inherited>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-build-resources</id>
                        <inherited>false</inherited>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-prepare-agent</id>
                        <inherited>false</inherited>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-prepare-agent-integration</id>
                        <inherited>false</inherited>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-report</id>
                        <inherited>false</inherited>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>integration-report</id>
                        <inherited>false</inherited>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- When changing this, the `freelib.resources.version` property must also be changed -->
    <parent>
        <artifactId>freelib-parent</artifactId>
        <groupId>info.freelibrary</groupId>
        <version>14.3.6</version>
    </parent>

</project>
